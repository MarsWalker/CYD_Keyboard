    {
      "Type": "Slider", "Text": "Volume",
      "X": 10, "Y": 122, "Width": 300, "Height": 46,
      "Mode": "Relative", "RepeatMs": 160,
      "Decrease": "VolumeDown", "Increase": "VolumeUp"
    },
    {
      "Type": "Slider", "Text": "Brilho",
      "X": 10, "Y": 184, "Width": 300, "Height": 46,
      "Mode": "Relative", "RepeatMs": 220,
      "Decrease": "BrightnessDown", "Increase": "BrightnessUp"
    }
