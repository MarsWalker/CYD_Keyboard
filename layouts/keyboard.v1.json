{
  "Bluetooth": { "Name": "CYD Keyboard 01" },
  "KeyboardLayout": "pt-PT",
  "Screen": { "Rotation": 1, "Invert": true, "Background": "Black" },
  "Objects": [
    {
      "Type": "Button", "Text": "Copy",
      "X": 10, "Y": 48, "Width": 69, "Height": 58,
      "Action": { "Type": "Keys", "Keys": ["CTRL", "C"] }
    },
    {
      "Type": "Button", "Text": "Paste",
      "X": 87, "Y": 48, "Width": 69, "Height": 58,
      "Action": { "Type": "Keys", "Keys": ["CTRL", "V"] }
    },
    {
      "Type": "Button", "Text": "F12",
      "X": 164, "Y": 48, "Width": 69, "Height": 58,
      "Action": { "Type": "Keys", "Keys": ["F12"] }
    },
    {
      "Type": "Button", "Text": "Mute",
      "X": 241, "Y": 48, "Width": 69, "Height": 58,
      "Action": { "Type": "Consumer", "Command": "Mute" }
